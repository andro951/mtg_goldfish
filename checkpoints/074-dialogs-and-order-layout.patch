--- a/src/tabletop/styles.css
+++ b/src/tabletop/styles.css
@@ -38 +38,26 @@
 .mode-preferences{border-top:1px solid var(--line);margin-top:7px;padding-top:5px}.mode-pref-row{display:flex;align-items:center;gap:5px;justify-content:space-between;font-size:10px}.mode-pref-row>span{color:#b5c6cd;white-space:nowrap}.mode-pref-buttons{display:flex;gap:2px;flex-wrap:wrap;justify-content:flex-end}.mode-pref-buttons button{padding:3px 5px;font-size:9px;line-height:1.2}.float-header [data-action="revise-choice"]{padding:2px 5px;font-size:9px;min-height:20px;color:var(--gold);border:1px solid #78633f;background:#2a251c}
+
+/* Tabletop 1.3: cheap composited drag, compact owned-slot zones, order workspace. */
+.drag-ghost{will-change:transform;contain:layout style;pointer-events:none}
+.drag-ghost .playing-card{box-shadow:0 3px 6px #0008}
+.ordering-window{width:650px;min-width:280px;min-height:160px;max-width:calc(100vw - 8px);max-height:calc(100dvh - 40px);display:flex;flex-direction:column}
+.ordering-window .float-body{display:flex;flex:1;min-height:0;flex-direction:column;overflow:hidden}
+.ordering-window .ordered-list{flex:1;max-height:none;overflow:auto;min-height:40px}
+.ordering-window .choice-row{gap:4px;cursor:grab;padding:4px}
+.ordering-window .choice-row:active{cursor:grabbing}
+.ordering-window .order-label{flex:1;min-width:0;font-size:11px}
+.ordering-window .choice-row button{flex:0 0 24px;height:24px;padding:1px}
+.ordering-window .ordinal{flex:0 0 20px;color:var(--gold);font-size:10px}
+.order-grip{color:var(--muted);font-size:17px;flex:0 0 12px}
+.order-footer{padding-top:7px;flex-shrink:0}
+.popup-resize{position:absolute;right:0;bottom:0;width:18px;height:18px;cursor:nwse-resize;background:linear-gradient(135deg,transparent 60%,var(--gold) 62%,transparent 70%,var(--gold) 76%,transparent 84%);touch-action:none}
+.player-policy{border-top:1px solid var(--line);padding-top:5px;margin-top:5px}
+.auto-accept{font-size:10px;color:var(--muted);padding:4px 8px}
+[hidden]{display:none!important}
+
+/* User-authored shortcuts and sequence editor. */
+.program-intro{margin-bottom:14px}.program-intro p{font-size:12px;line-height:1.6}.program-list{display:grid;gap:12px}.sequence-card,.rule-card,.rule-editor{padding:12px;border:1px solid var(--line);border-radius:9px;background:#101c22}.sequence-card header,.rule-card header{display:flex;align-items:center;gap:8px;margin-bottom:9px}.sequence-card header input,.rule-card header label{flex:1;min-width:0}.sequence-card header input{font-weight:600}.sequence-card input[type=number]{width:63px}.sequence-card label,.rule-card p,.rule-card small{font-size:11px}.sequence-step{display:flex;gap:4px;align-items:center;padding:6px 0;border-top:1px solid var(--line)}.sequence-step span{flex:1;font-size:11px}.sequence-step button{padding:2px 6px}.program-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.program-field{display:grid;gap:4px;min-width:0;font-size:11px}.program-field select{width:100%;min-width:0}.rule-editor{margin:14px 0;border-color:var(--gold)}.rule-editor h3{margin:0}.rule-conditions{display:grid;gap:7px;margin:12px 0}.rule-conditions select:first-child{flex:1;min-width:0}.rule-conditions select{font-size:11px;max-width:65%}.empty-programs{text-align:center;padding:35px;color:var(--muted)}.program-recording{border:1px solid #d09175;padding:14px;border-radius:8px}.program-recording>label{margin:10px 0}.record-indicator{color:#ffa090!important}.stack-entry{position:relative;flex-shrink:0}.stack-hook{position:absolute;right:3px;top:3px;background:#101b22ed;border:1px solid var(--gold);width:23px;height:23px;padding:0;font-size:16px}.program-tools svg{width:16px;height:16px}
+@media(max-width:600px){.program-form-grid{grid-template-columns:1fr}.program-intro .row{flex-wrap:wrap}}
+
+/* Clockwise around the physical bottom-right, shifted to the upright left anchor. */
+.card-position.tapped{transform-origin:bottom right;transform:translateX(-110px) rotate(90deg)}
