diff --git a/src/tabletop/styles.css b/src/tabletop/styles.css
--- a/src/tabletop/styles.css
+++ b/src/tabletop/styles.css
@@ -122,0 +123,9 @@
+
+/* Look is a floating, read-only card surface, independent of the zone dock. */
+.workspace-window{width:360px;height:380px;min-width:min(280px,calc(100vw - 8px));min-height:160px;max-width:calc(100vw - 8px);max-height:calc(100dvh - 40px);display:flex;flex-direction:column}
+.workspace-window>.float-body{padding:0;overflow:hidden;display:flex;flex-direction:column;flex:1;min-height:0}
+.workspace-window>.float-header{flex-shrink:0}.workspace-window>.float-header strong{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.workspace-window .surface{flex:1;min-height:0;width:100%;border-radius:0 0 6px 6px;background:#101c23}
+.workspace-caption{flex-shrink:0;padding:5px 8px;border-bottom:1px solid var(--line);font-size:10px;display:flex;justify-content:space-between;gap:6px;color:var(--muted)}
+.workspace-caption>span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}.workspace-caption>small{white-space:nowrap}
+.workspace-window .view-control{right:20px}.workspace-window .popup-resize{z-index:10}
