+ r.registerHandler('gods.carpet',(g,c)=>{const n=g.islandCount(c.inputs.player)+carpetAssumedIslands(g,c.controller);if(n<=0)return [];g.useOnce(c.source,'carpet');return [{op:'mana',color:c.vars.carpetColor,amount:n}];});
