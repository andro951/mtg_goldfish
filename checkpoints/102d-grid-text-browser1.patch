diff --git a/tests/grid-responsive.test.js b/tests/grid-responsive.test.js
new file mode 100644
index 0000000..b214461
--- /dev/null
+++ b/tests/grid-responsive.test.js
@@ -0,0 +1,30 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { gridLayout,bestGridShape } from '../src/tabletop/grid.js';
+import { fitCamera,CARD_W,CARD_H } from '../src/tabletop/geometry.js';
+const objects=n=>Array.from({length:n},(_,i)=>({id:'c'+i,oid:1,zone:'graveyard',flags:{},location:null,tapped:false}));
+function footprint(cards,camera){
+ const left=Math.min(...cards.map(c=>c.x))*camera.zoom+camera.x;
+ const right=Math.max(...cards.map(c=>c.x+CARD_W))*camera.zoom+camera.x;
+ const top=Math.min(...cards.map(c=>c.y-CARD_H))*camera.zoom+camera.y;
+ const bottom=Math.max(...cards.map(c=>c.y))*camera.zoom+camera.y;
+ return {width:right-left,height:bottom-top};
+}
+test('responsive grid chooses materially more columns as the dock widens',()=>{
+ const n=27,narrow=gridLayout(objects(n),[],320,600),medium=gridLayout(objects(n),[],560,600),wide=gridLayout(objects(n),[],840,600);
+ assert.ok(narrow.shape.columns<medium.shape.columns);assert.ok(medium.shape.columns<=wide.shape.columns);
+ assert.equal(new Set(wide.cards.map(c=>c.gridSlot)).size,n);
+});
+test('responsive grid plus fit camera uses most of both dimensions at representative resizes',()=>{
+ for(const [w,h] of [[320,600],[520,520],[840,470],[700,700]]){
+  const grid=gridLayout(objects(27),[],w,h),camera=fitCamera(grid.cards,w,h,8),box=footprint(grid.cards,camera);
+  assert.ok(box.width/w>.68,`${w}x${h} width occupancy ${box.width/w}`);
+  assert.ok(box.height/h>.68,`${w}x${h} height occupancy ${box.height/h}`);
+ }
+});
+test('responsive reflow changes only grid-owned coordinates; detached card remains fixed',()=>{
+ const list=objects(12),first=gridLayout(list,[],320,600),detached={...list[3],location:{x:713,y:421,anchor:'corner-v2'}};
+ const second=gridLayout(list.map((o,i)=>i===3?detached:o),first.slots,800,450),manual=second.cards.find(c=>c.id==='c3');
+ assert.equal(manual.gridSlot,null);assert.deepEqual({x:manual.x,y:manual.y},{x:713,y:421});
+ assert.ok(second.cards.some((c,i)=>c.id!=='c3'&&c.x!==first.cards.find(a=>a.id===c.id)?.x));
+});
