 diff --git a/src/tabletop/styles.css b/src/tabletop/styles.css
--- a/src/tabletop/styles.css
+++ b/src/tabletop/styles.css
@@ -87,0 +88,13 @@
+
+/* Separate legacy text deck editor. */
+.deck-text-modal{width:min(820px,calc(100vw - 20px));height:min(860px,94dvh)}
+.deck-text-modal .modal-body{display:flex;flex-direction:column;min-height:0;overflow:hidden;gap:8px}
+.deck-text-toolbar{display:flex;align-items:end;justify-content:space-between;gap:12px;flex-wrap:wrap;flex-shrink:0}
+.deck-text-toolbar>div{font-variant-numeric:tabular-nums;color:var(--muted)}.deck-text-toolbar strong{color:var(--gold)}
+.deck-text-area{flex:1;min-height:80px;resize:none;font:12px/1.45 ui-monospace,SFMono-Regular,Consolas,monospace;white-space:pre;tab-size:2}
+.deck-text-help{display:flex;gap:7px;align-items:center;flex-wrap:wrap;color:var(--muted);font-size:10px;flex-shrink:0}.deck-text-help code{padding:2px 5px;border:1px solid var(--line);border-radius:3px;background:#0d171c;color:#c6d5da}
+@media(max-width:600px){.deck-text-modal{height:96dvh}.deck-text-modal .modal-body{padding:8px}.deck-text-toolbar small{display:none}}
+.deck-text-modal .modal-body{flex:1}
+
+.deck-text-issues{flex-shrink:0;max-height:100px;overflow:auto;white-space:pre-wrap;color:#ffc89c;font-size:11px;margin:0}
+.deck-text-modal .modal-footer{flex-wrap:wrap;gap:6px;padding:8px 12px}
