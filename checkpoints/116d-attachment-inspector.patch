+function attachmentControls(g,o){
+ const target=o.attachedTo&&g.object(o.attachedTo),follow=followsAttachment(o);
+ const links=permanentLinks(g),children=links.filter(l=>l.kind!=='soulbond'&&l.target===o.id);
+ const attached=children.length?`<div class="attached-list"><small>Attached cards</small>${children.map(l=>button(h(l.name),'inspect-link',`data-id="${h(l.source)}" title="Inspect attached card"`,'quiet')).join('')}</div>`:'';
+ const pair=links.find(l=>l.kind==='soulbond'&&(l.source===o.id||l.target===o.id));
+ const pairing=pair?`<p class="bond-status">Soulbond · paired with ${h(g.definition(g.object(pair.source===o.id?pair.target:pair.source)).name)}</p>`:'';
+ if(!canFollow(g,o))return pairing+attached;
+ return `<div class="attachment-controls"><small>${target?.zone==='battlefield'?`Attached to ${h(g.definition(target).name)}`:'Not attached'}</small>${button('Follow attached permanent','attachment-follow',`data-id="${h(o.id)}" aria-pressed="${follow}" title="${follow?'Move this card with its host. Dragging it separately turns following off.':'Move this card back underneath its host and resume following.'}"`,follow?'follow-toggle active':'follow-toggle')}<small>${follow?'Following · tucked behind its host':'Manual position · connection stays visible'}</small></div>`+pairing+attached;
