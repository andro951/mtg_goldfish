diff --git a/tests/ui_acceptance_grid_text.py b/tests/ui_acceptance_grid_text.py
new file mode 100644
index 0000000..3e25e49
--- /dev/null
+++ b/tests/ui_acceptance_grid_text.py
@@ -0,0 +1,44 @@
+from ui_acceptance_support import *
+
+def _dock_resize(p,width):
+ current=p.evaluate('astra.prefs.dockWidth');handle=p.locator('.dock-resize').bounding_box();dx=current-width
+ drag(p,handle['x']+2,handle['y']+80,handle['x']+2+dx,handle['y']+80)
+ p.wait_for_timeout(160)
+
+def _grid_metrics(p):
+ return p.evaluate('''() => {
+  const s=document.querySelector('[data-surface="graveyard"]').getBoundingClientRect();
+  const els=[...document.querySelectorAll('[data-surface="graveyard"] [data-position]')].filter(e=>astra.ui.layouts.graveyard.find(c=>c.id===e.dataset.position)?.gridSlot!==null);
+  const rs=els.map(e=>e.getBoundingClientRect());
+  const box={left:Math.min(...rs.map(r=>r.left)),right:Math.max(...rs.map(r=>r.right)),top:Math.min(...rs.map(r=>r.top)),bottom:Math.max(...rs.map(r=>r.bottom))};
+  return {surface:{w:s.width,h:s.height},cards:{w:box.right-box.left,h:box.bottom-box.top},columns:new Set(astra.ui.layouts.graveyard.filter(c=>c.gridSlot!==null).map(c=>Math.round(c.x))).size,zoom:astra.prefs.cameras.graveyard.zoom,count:els.length};
+ }''')
+
+def grid_resize_visual(p):
+ fixture(p,'grid-resize');click(p,'zone',extra='[data-zone="graveyard"]');p.wait_for_timeout(180)
+ results=[]
+ for width,name in [(250,'22-grid-narrow.png'),(470,'23-grid-medium.png'),(780,'24-grid-wide.png')]:
+  _dock_resize(p,width);m=_grid_metrics(p);results.append(m)
+  check(f'graveyard grid owns all 27 cards at {width}px dock',m['count']==27)
+  check(f'graveyard grid fills width at {width}px dock',m['cards']['w']/m['surface']['w']>.66,m)
+  check(f'graveyard grid fills height at {width}px dock',m['cards']['h']/m['surface']['h']>.66,m)
+  shot(p,name)
+ check('wider graveyard dynamically adds grid columns',results[0]['columns']<results[1]['columns']<=results[2]['columns'],results)
+ check('graveyard grid zoom adapts instead of retaining stale 34-percent fit',max(r['zoom'] for r in results)-min(r['zoom'] for r in results)>.08,results)
+ # User can zoom after layout; resizing again returns the responsive grid to a fitted state.
+ surface=p.locator('[data-surface="graveyard"]').bounding_box();p.mouse.move(surface['x']+surface['width']/2,surface['y']+surface['height']/2);p.mouse.wheel(0,500);p.wait_for_timeout(120);manual=p.evaluate('astra.prefs.cameras.graveyard.zoom')
+ _dock_resize(p,600);after=_grid_metrics(p)
+ check('resizing after manual zone zoom reflows and refits the grid to its new space',abs(after['zoom']-manual)>.03 and after['cards']['w']/after['surface']['w']>.66 and after['cards']['h']/after['surface']['h']>.66)
+
+def deck_text_editor(p):
+ menu(p);check('menu exposes visual and text deck editors separately',p.locator('[data-dialog="deck"]').count()==1 and p.locator('[data-dialog="decktext"]').count()==1)
+ click(p,'dialog','.modal','[data-dialog="decktext"]')
+ check('text editor is a separate full-height modal rather than a collapsed visual-editor section',p.locator('.deck-text-modal #deck-text').is_visible() and p.locator('.deck-editor-shell').count()==0)
+ original=p.locator('#deck-text').input_value();assert '1 Mox Amber' in original
+ edited=original.replace('1 Mox Amber','2 Mox Amber',1);p.locator('#deck-text').fill(edited);click(p,'deck-apply-text','.modal')
+ check('old-style text edit validates and updates the shared deck source',p.evaluate('astra.ui.deckReport.accepted') and p.evaluate('astra.ui.deckText.includes("2 Mox Amber")'))
+ click(p,'dialog','.modal','[data-dialog="deck"]');p.locator('#deck-search').fill('Mox Amber')
+ check('visual editor immediately sees the text-editor quantity',p.locator('.deck-browser-card .deck-membership').inner_text().find('M2')>=0)
+ click(p,'dialog','.modal','[data-dialog="decktext"]');check('switching back to text retains visual/text shared state','2 Mox Amber' in p.locator('#deck-text').input_value())
+ p.locator('#deck-text').fill(original);click(p,'deck-apply-text','.modal');check('text editor can restore the original list through plain text',p.evaluate('astra.ui.deckReport.accepted') and not p.evaluate('astra.ui.deckText.includes("2 Mox Amber")'))
+ shot(p,'25-deck-text-editor.png')
