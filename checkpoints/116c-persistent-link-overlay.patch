diff --git a/src/tabletop/styles.css b/src/tabletop/styles.css
--- a/src/tabletop/styles.css
+++ b/src/tabletop/styles.css
@@ -106,2 +106,17 @@
 .loyalty-badge{position:absolute;right:3%;bottom:4.5%;min-width:20%;height:11%;display:flex;align-items:center;justify-content:center;padding:0 2px;border:1px solid #72949e;border-radius:3px 3px 7px 7px;background:#10212bf5;color:#fff;font-size:12px;font-weight:700;line-height:1;font-variant-numeric:tabular-nums;pointer-events:none;z-index:2}
